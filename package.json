{
  "name": "technical-test-davivienda",
  "version": "0.1.0",
  "private": true,
  "description": "Buscador y visor de documentos tecnicos con indexacion asincrona y busqueda full-text",
  "author": "nicolassanchez1 <nicolassanchez115@hotmail.com>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm run lint:ts && pnpm run lint:java",
    "lint:ts": "eslint .",
    "lint:java": "./backend/mvnw -B -f backend/pom.xml spotless:check",
    "lint:fix": "eslint . --fix && ./backend/mvnw -B -f backend/pom.xml spotless:apply",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm run test:java && pnpm run test:ts",
    "test:java": "./backend/mvnw -B -f backend/pom.xml test",
    "test:ts": "pnpm --recursive test",
    "test:integration": "./backend/mvnw -B -f backend/pom.xml verify",
    "build": "./backend/mvnw -B -f backend/pom.xml package && pnpm --recursive build",
    "contract:generate": "pnpm run test:integration && pnpm --filter @technical-test-davivienda/shared contract:generate",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
