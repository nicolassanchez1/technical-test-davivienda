# Copy to .env before running docker compose. Never commit the real .env.

# PostgreSQL
POSTGRES_DB=documents
POSTGRES_USER=documents
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/documents
SPRING_DATASOURCE_USERNAME=documents
SPRING_DATASOURCE_PASSWORD=change-me

# RabbitMQ
RABBITMQ_DEFAULT_USER=documents
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=documents
SPRING_RABBITMQ_PASSWORD=change-me

# Application settings. Every one is validated at boot; a wrong value stops startup.
APP_STORAGE_DIR=./storage
APP_MAX_FILE_SIZE_MB=20
APP_MAX_FILES_PER_UPLOAD=10
APP_SEARCH_TIMEOUT_MS=900
APP_SEARCH_MAX_PAGE_SIZE=50
APP_WORKER_CONCURRENCY=4
APP_STUCK_PROCESSING_MINUTES=10
APP_SSE_HEARTBEAT_MS=15000

# Structured logs for container runs. Leave unset locally for human-readable output.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# Exposed ports. The web port is the only one a reverse proxy needs.
API_PORT=8081
WEB_PORT=8080
